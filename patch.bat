$exe = 'DRAGON QUEST XI.exe', 'Game/Binaries/Win64/DRAGON QUEST XI.exe' | ForEach-Object { Join-Path (Get-Location) $_ } | Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1
if (!$exe) { Write-Host 'Game exe not found. Put this file in the DRAGON QUEST XI folder or next to the exe.'; return }
try { $f = [IO.File]::Open($exe, 'Open', 'ReadWrite') } catch { Write-Host ('Cannot open the exe for writing (is the game running?): ' + $_.Exception.Message); return }
try {
  $read = { param($off, $n) $b = New-Object byte[] $n; $null = $f.Seek($off, 'Begin'); $null = $f.Read($b, 0, $n); -join ($b | ForEach-Object { $_.ToString('x2') }) }
  $put = { param($off, $hex) $b = [byte[]]($hex -split '(..)' -ne '' | ForEach-Object { [Convert]::ToByte($_, 16) }); $null = $f.Seek($off, 'Begin'); $f.Write($b, 0, $b.Length) }
  $want = { param($u) if ($u[3]) { $u[3] } else { $u[1] } }
  $ok = $true; $patched = $true
  $at = { param($off, $h) if (!$h) { return $false }; (& $read $off ($h.Length / 2)) -eq $h }
  foreach ($c in $cam) {
    if (!((& $at $c[0] $c[1]) -or (& $at $c[0] $c[2]))) { $ok = $false }
    if (!(& $at $c[0] $c[2])) { $patched = $false }
  }
  foreach ($u in $ui) {
    $w = & $want $u
    $matched = (& $at $u[0] $u[1]) -or (& $at $u[0] $w)
    foreach ($alt in $u[2]) { if (& $at $u[0] $alt) { $matched = $true } }
    if (!$matched) { $ok = $false }
    if (!(& $at $u[0] $w)) { $patched = $false }
  }
  if (!$ok) { Write-Host 'Unrecognised exe (different game version?) - nothing was changed.'; return }
  if ($patched) {
    foreach ($c in $cam) { & $put $c[0] $c[1] }
    foreach ($u in $ui) { & $put $u[0] $u[1] }
    Write-Host 'Patch removed: exe is back to original. Run again to re-apply.'
  } else {
    foreach ($c in $cam) { & $put $c[0] $c[2] }
    foreach ($u in $ui) { & $put $u[0] (& $want $u) }
    Write-Host 'Patched: ultrawide enabled (21:9 HUD & fades; centred dialog/quest/menus/map/loading/videos). Run again to undo.'
  }
} finally { $f.Close() }
